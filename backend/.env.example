# Copy to .env and set the password from docker-compose.yml.
# Run commands from backend (or use go -C backend from the project root).
DATABASE_URL="host=localhost user=postgres password=YOUR_PASSWORD dbname=recycle_system port=5432 sslmode=disable TimeZone=Asia/Bangkok"
HTTP_ADDR=127.0.0.1:8080
# Optional: Photon-compatible search provider. No API key needed for the demo.
# GEOCODER_URL=https://photon.komoot.io/api/

# Integration tests use temporary schemas in this database.
# Remove this line to skip PostgreSQL tests, or set a separate test database URL.
TEST_DATABASE_URL="${DATABASE_URL}"
