{
  "info": {
    "name": "T20 - Driver Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "supervisor_id",
      "value": "DEMO-USER-SUP"
    },
    {
      "key": "driver_id",
      "value": "DEMO-D001"
    }
  ],
  "item": [
    {
      "name": "1. รายการคนขับ",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/drivers",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "drivers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. เพิ่มคนขับ (เปลี่ยนอีเมลและเลขใบขับขี่เมื่อเพิ่มคนใหม่)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"supervisor_id\": \"{{supervisor_id}}\",\n  \"name\": \"คนขับทดลอง\",\n  \"phone\": \"0812345678\",\n  \"email\": \"driver.new@example.test\",\n  \"position\": \"พนักงานขับรถ\",\n  \"hire_date\": \"2026-09-04\",\n  \"license_number\": \"TEST-LICENSE-002\",\n  \"license_expiry\": \"2030-09-04\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/drivers",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "drivers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"driver_id\", pm.response.json().employee_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. รายละเอียดคนขับ",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/drivers/{{driver_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "drivers",
            "{{driver_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. แก้เบอร์โทร",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"supervisor_id\": \"{{supervisor_id}}\",\n  \"phone\": \"0898765432\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/drivers/{{driver_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "drivers",
            "{{driver_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
