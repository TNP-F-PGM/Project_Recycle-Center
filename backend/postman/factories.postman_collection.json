{
  "info": {
    "_postman_id": "9ce14e72-53af-44d2-a7e2-11c647fcb886",
    "name": "T20 - Factories",
    "description": "เพิ่มและแก้โรงงานพร้อมพิกัด ข้อมูลตัวอย่างจะถูกบันทึกจริงเมื่อกด Send ให้เปลี่ยนข้อมูลและพิกัดก่อนใช้งาน รันคำขอสร้างก่อนเพื่อเก็บ factory_id อัตโนมัติ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "factory_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. List factories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/factories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "factories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create factory with location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/factories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "factories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_name\": \"Example Factory\",\n  \"contact_person\": \"Example Contact\",\n  \"phone\": \"0812345678\",\n  \"address\": \"Replace with the real factory address\",\n  \"latitude\": 13.7563,\n  \"longitude\": 100.5018\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"factory_id\", pm.response.json().factory_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get saved factory",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/factories/{{factory_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "factories",
            "{{factory_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Edit factory and location",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/factories/{{factory_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "factories",
            "{{factory_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address\": \"Updated example address\",\n  \"latitude\": 14,\n  \"longitude\": 101\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
